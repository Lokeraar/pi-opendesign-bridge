{
  "name": "@lokeraar/pi-opendesign-bridge",
  "version": "0.2.1",
  "description": "EnClave-style live model catalog for OpenDesign in Pi: /login once and the router's models appear in /model with real context windows, real output ceilings, reasoning levels and input modalities \u2014 resolved from the model catalog Pi already ships, no extra account needed.",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "*.ts",
    "README.md",
    "LICENSE",
    "scripts/diagnose.mjs"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "provider",
    "ai",
    "ai-provider",
    "llm",
    "opendesign",
    "open-design",
    "openai-compatible",
    "model-catalog",
    "model-sync",
    "ai-model"
  ],
  "author": "Lokeraar",
  "license": "MIT",
  "homepage": "https://pi.dev/packages/@lokeraar/pi-opendesign-bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lokeraar/pi-opendesign-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Lokeraar/pi-opendesign-bridge/issues"
  },
  "scripts": {
    "test": "node --experimental-strip-types scripts/test-donors.mjs",
    "diagnose": "node --experimental-strip-types scripts/diagnose.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
